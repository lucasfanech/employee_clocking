{% extends 'base.html.twig' %}
{% import '_partials/icons.html.twig' as icons %}

{% block title %}{{ 'Profile'|trans }} · Clocking{% endblock %}

{% block band %}
    <div class="mx-auto max-w-4xl">
        <p class="eyebrow text-amber-400">{{ app.user.email }}{% if is_granted('ROLE_ADMIN') %} · {{ 'administrator'|trans }}{% endif %}</p>
        <h1 class="band-title mt-2">{{ 'Profile'|trans }}</h1>
    </div>
{% endblock %}

{% block body %}
    <div class="mx-auto max-w-4xl">
        <div class="grid gap-6 md:grid-cols-2">
            <section class="sheet sheet-body">
                <h2 class="flex items-center gap-2 text-lg font-semibold text-ink-900">
                    {{ icons.icon('user', 'h-5 w-5 text-cobalt-600') }}
                    {{ 'Account'|trans }}
                </h2>
                {{ form_start(profile_form, {attr: {class: 'mt-4 space-y-4', novalidate: 'novalidate'}}) }}
                    {{ form_row(profile_form.email) }}
                    <button type="submit" class="btn btn-primary">{{ 'Update e-mail'|trans }}</button>
                {{ form_end(profile_form) }}
            </section>

            <section class="sheet sheet-body">
                <h2 class="flex items-center gap-2 text-lg font-semibold text-ink-900">
                    {{ icons.icon('key', 'h-5 w-5 text-cobalt-600') }}
                    {{ 'Password'|trans }}
                </h2>
                {{ form_start(password_form, {attr: {class: 'mt-4 space-y-4', novalidate: 'novalidate'}}) }}
                    {{ form_row(password_form.plainPassword.first) }}
                    {{ form_row(password_form.plainPassword.second) }}
                    <button type="submit" class="btn btn-primary">{{ 'Change password'|trans }}</button>
                {{ form_end(password_form) }}
            </section>
        </div>

        <section class="sheet sheet-body mt-6 ring-minus-600/30">
            <h2 class="flex items-center gap-2 text-lg font-semibold text-minus-700">
                {{ icons.icon('alert', 'h-5 w-5') }}
                {{ 'Danger zone'|trans }}
            </h2>
            <p class="mt-2 text-sm text-ink-600">{{ 'Delete every clocking time and day off of your account. Your working hours are kept.'|trans }}</p>
            <form method="post" action="{{ path('app_profile_reset_data') }}" class="mt-4"
                  data-controller="confirm" data-confirm-message-value="{{ 'Delete all your clocking data? This cannot be undone.'|trans }}" data-action="submit->confirm#ask">
                <input type="hidden" name="_token" value="{{ csrf_token('reset-data') }}">
                <button type="submit" class="btn btn-danger-outline">
                    {{ icons.icon('trash', 'h-4 w-4') }}
                    {{ 'Delete all my clocking data'|trans }}
                </button>
            </form>
        </section>
    </div>
{% endblock %}
