{% extends 'base.html.twig' %}
{% import '_partials/icons.html.twig' as icons %}

{% block title %}{{ 'Working hours'|trans }} · Clocking{% endblock %}

{% block band %}
    <div class="mx-auto max-w-3xl">
        <p class="eyebrow text-amber-400">{{ 'Your rules'|trans }}</p>
        <h1 class="band-title mt-2">{{ 'Working hours'|trans }}</h1>
        <p class="mt-3 text-ink-300">
            {% if is_new %}
                {{ 'Welcome! Check the defaults below and save them to start clocking.'|trans }}
            {% else %}
                {{ 'These rules drive every balance and estimate on your week page.'|trans }}
            {% endif %}
        </p>
    </div>
{% endblock %}

{% block body %}
    <div class="mx-auto max-w-3xl">
        {{ form_start(form, {attr: {class: 'space-y-6', novalidate: 'novalidate'}}) }}
            <section class="sheet sheet-body">
                <h2 class="flex items-center gap-2 text-lg font-semibold text-ink-900">
                    {{ icons.icon('chart', 'h-5 w-5 text-cobalt-600') }}
                    {{ 'Weekly target'|trans }}
                </h2>
                <div class="mt-4">
                    {{ form_row(form.weeklyMinutes) }}
                    <p class="mt-2 text-xs text-ink-500">
                        {{ 'Current daily target: %target% (%weekly% ÷ 5).'|trans({'%target%': schedule.dailyMinutes|duration_minutes, '%weekly%': schedule.weeklyMinutes|duration_minutes}) }}
                    </p>
                </div>
            </section>

            <section class="sheet sheet-body">
                <h2 class="flex items-center gap-2 text-lg font-semibold text-ink-900">
                    {{ icons.icon('coffee', 'h-5 w-5 text-cobalt-600') }}
                    {{ 'Lunch break'|trans }}
                </h2>
                <div class="mt-4 grid gap-6 sm:grid-cols-2">
                    {{ form_row(form.lunchBreakMinutes) }}
                    {{ form_row(form.shortLunchBreakMinutes) }}
                </div>
                <div class="mt-4">
                    {{ form_row(form.shortLunchBreakDays) }}
                </div>
            </section>

            <div class="flex items-center justify-end gap-3">
                <a href="{{ path('app_home') }}" class="btn btn-ghost">{{ 'Cancel'|trans }}</a>
                <button type="submit" class="btn btn-primary">
                    {{ icons.icon('save', 'h-4 w-4') }}
                    {{ 'Save working hours'|trans }}
                </button>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
