{% extends 'base.html.twig' %}
{% import '_partials/icons.html.twig' as icons %}

{% block title %}Clocking · Know when you can leave{% endblock %}

{% block main %}
    {# ---------------------------------------------------------------- Hero #}
    <section class="relative overflow-hidden">
        <div class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(60rem_40rem_at_80%_-10%,theme(--color-brand-100),transparent)]"></div>
        <div class="mx-auto grid max-w-7xl items-center gap-12 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:px-8 lg:py-24">
            <div>
                <span class="badge badge-neutral mb-5 gap-2 py-1 pl-1 pr-3">
                    <span class="rounded-full bg-brand-700 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wide text-white">New</span>
                    Live daily balance &amp; leaving-time estimate
                </span>
                <h1 class="text-4xl font-extrabold tracking-tight text-stone-900 sm:text-5xl lg:text-6xl">
                    Clock in.<br>
                    Clock out.<br>
                    <span class="text-brand-700">Know when you can leave.</span>
                </h1>
                <p class="mt-6 max-w-xl text-lg leading-8 text-stone-600">
                    Clocking keeps track of your four daily times, computes the balance of every day against your
                    weekly target, cumulates it over the week and tells you the exact time you can go home.
                </p>
                <div class="mt-8 flex flex-wrap items-center gap-3">
                    <a href="{{ path('app_register') }}" class="btn btn-primary px-6 py-3 text-base">
                        Create your account
                        {{ icons.icon('arrow-right', 'h-5 w-5') }}
                    </a>
                    <a href="{{ path('app_login') }}" class="btn btn-secondary px-6 py-3 text-base">
                        {{ icons.icon('login', 'h-5 w-5') }}
                        Sign in
                    </a>
                </div>
                <p class="mt-4 text-sm text-stone-500">Free, self-hosted, no tracking. The first account becomes the administrator.</p>
            </div>

            {# Static preview of the week grid #}
            <div class="card overflow-hidden">
                <div class="flex items-center justify-between border-b border-stone-100 px-5 py-4">
                    <div>
                        <p class="text-xs font-semibold uppercase tracking-wide text-stone-500">Week 10 · 2026</p>
                        <p class="text-sm text-stone-600">Monday 2 March → Friday 6 March</p>
                    </div>
                    <span class="badge badge-positive shrink-0">Week: +0:42</span>
                </div>
                <table class="w-full text-sm">
                    <thead class="bg-stone-50 text-left text-xs uppercase tracking-wide text-stone-500">
                        <tr>
                            <th class="px-5 py-2 font-semibold">Day</th>
                            <th class="px-2 py-2 font-semibold">In</th>
                            <th class="px-2 py-2 font-semibold">Lunch</th>
                            <th class="px-2 py-2 font-semibold">Back</th>
                            <th class="px-2 py-2 font-semibold">Out</th>
                            <th class="px-5 py-2 text-right font-semibold">+/-</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-stone-100 font-mono tabular-nums">
                        {% set demo = [
                            {d: 'Mon', t: ['08:02', '12:15', '13:10', '17:05'], b: '+0:16', c: 'badge-positive'},
                            {d: 'Tue', t: ['08:30', '12:30', '13:30', '17:00'], b: '-0:12', c: 'badge-negative'},
                            {d: 'Wed', t: ['07:55', '12:00', '12:45', '16:58'], b: '+0:21', c: 'badge-positive'},
                            {d: 'Thu', t: ['08:10', '12:20', '13:05', '17:00'], b: '+0:03', c: 'badge-positive'},
                        ] %}
                        {% for row in demo %}
                            <tr>
                                <td class="px-5 py-2.5 font-sans font-semibold text-stone-800">{{ row.d }}</td>
                                {% for t in row.t %}<td class="px-2 py-2.5 text-stone-700">{{ t }}</td>{% endfor %}
                                <td class="px-5 py-2.5 text-right"><span class="badge {{ row.c }}">{{ row.b }}</span></td>
                            </tr>
                        {% endfor %}
                        <tr class="bg-brand-50/60">
                            <td class="px-5 py-2.5 font-sans font-semibold text-brand-900">Fri <span class="ml-1 badge badge-warning font-sans">today</span></td>
                            <td class="px-2 py-2.5 text-stone-700">08:04</td>
                            <td class="px-2 py-2.5 text-stone-700">12:10</td>
                            <td class="px-2 py-2.5 text-stone-700">12:55</td>
                            <td class="px-2 py-2.5 text-stone-400">--:--</td>
                            <td class="px-5 py-2.5 text-right"><span class="badge badge-neutral">—</span></td>
                        </tr>
                    </tbody>
                </table>
                <div class="grid grid-cols-2 gap-3 border-t border-stone-100 bg-stone-50 p-4">
                    <div class="rounded-xl bg-white p-4 ring-1 ring-stone-900/5">
                        <p class="text-xs font-semibold uppercase tracking-wide text-stone-500">End of the day</p>
                        <p class="mt-1 font-mono text-3xl font-bold tabular-nums text-stone-900">16:31</p>
                    </div>
                    <div class="rounded-xl bg-brand-700 p-4 text-white shadow-sm">
                        <p class="text-xs font-semibold uppercase tracking-wide text-brand-100">With week balance</p>
                        <p class="mt-1 font-mono text-3xl font-bold tabular-nums">16:03</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# ------------------------------------------------------- How it works #}
    <section class="border-y border-stone-200 bg-white">
        <div class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
            <div class="mx-auto max-w-2xl text-center">
                <h2 class="text-3xl font-bold tracking-tight text-stone-900">Four times a day, that's all it takes</h2>
                <p class="mt-3 text-stone-600">No timer to remember. Type the times when you have them; the numbers update live.</p>
            </div>
            <ol class="mt-12 grid gap-8 md:grid-cols-4">
                {% set steps = [
                    {icon: 'sun', title: 'Morning in', text: 'Arrive and note the time. The leaving-time estimate appears immediately.'},
                    {icon: 'coffee', title: 'Lunch out / back', text: 'Your break is checked against the minimum you configured, with shorter days allowed.'},
                    {icon: 'moon', title: 'Evening out', text: 'The day is balanced: overtime or missing minutes, to the minute.'},
                    {icon: 'chart', title: 'Week cumulated', text: 'Balances add up from Monday to Friday and adjust the time you can leave today.'},
                ] %}
                {% for step in steps %}
                    <li class="relative rounded-2xl bg-stone-50 p-6 ring-1 ring-stone-900/5">
                        <span class="absolute right-5 top-5 text-4xl font-black text-stone-200">{{ loop.index }}</span>
                        <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-100 text-brand-800">
                            {{ icons.icon(step.icon, 'h-6 w-6') }}
                        </span>
                        <h3 class="mt-4 text-lg font-semibold text-stone-900">{{ step.title }}</h3>
                        <p class="mt-2 text-sm leading-6 text-stone-600">{{ step.text }}</p>
                    </li>
                {% endfor %}
            </ol>
        </div>
    </section>

    {# ------------------------------------------------------------ Features #}
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <div class="grid gap-6 lg:grid-cols-3">
            {% set features = [
                {icon: 'scale', title: 'Fair lunch-break rule', text: 'A break shorter than the minimum is not credited, so nobody games the clock. Pick the days where a shorter break is allowed.'},
                {icon: 'calendar-x', title: 'Days off in one click', text: 'Mark a day off and it is simply removed from the week: no balance, no estimate, no noise.'},
                {icon: 'shield', title: 'Multi-user &amp; self-hosted', text: 'Every colleague has an account and a schedule. Administrators manage accounts; data stays on your server.'},
            ] %}
            {% for feature in features %}
                <div class="card card-body">
                    <span class="flex h-11 w-11 items-center justify-center rounded-xl bg-brand-700 text-white">
                        {{ icons.icon(feature.icon, 'h-6 w-6') }}
                    </span>
                    <h3 class="mt-4 text-lg font-semibold text-stone-900">{{ feature.title|raw }}</h3>
                    <p class="mt-2 text-sm leading-6 text-stone-600">{{ feature.text }}</p>
                </div>
            {% endfor %}
        </div>

        <div class="mt-16 overflow-hidden rounded-3xl bg-brand-900 px-6 py-14 text-center text-white shadow-card sm:px-16">
            <h2 class="text-3xl font-bold tracking-tight">Ready to leave on time?</h2>
            <p class="mx-auto mt-3 max-w-xl text-brand-100">Create your account, set your weekly hours and lunch break, and start clocking today.</p>
            <div class="mt-8 flex flex-wrap justify-center gap-3">
                <a href="{{ path('app_register') }}" class="btn bg-white px-6 py-3 text-base text-brand-900 hover:bg-brand-50">
                    Create your account
                    {{ icons.icon('arrow-right', 'h-5 w-5') }}
                </a>
                <a href="{{ path('app_login') }}" class="btn px-6 py-3 text-base text-white ring-1 ring-white/40 ring-inset hover:bg-white/10">I already have one</a>
            </div>
        </div>
    </section>
{% endblock %}
