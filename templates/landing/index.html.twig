{% extends 'base.html.twig' %}
{% import '_partials/icons.html.twig' as icons %}
{% import '_partials/flap.html.twig' as flap %}

{% block title %}Clocking · {{ 'Know when you can leave.'|trans }}{% endblock %}

{% block main %}
    {# ------------------------------------------------ Hero: the thesis is the leaving time #}
    <section class="band relative overflow-hidden">
        <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(50rem_30rem_at_85%_0%,rgb(43_76_242_/_0.35),transparent_70%)]"></div>
        <div class="pointer-events-none absolute inset-x-0 bottom-0 h-px bg-white/10"></div>

        <div class="relative mx-auto grid max-w-7xl items-center gap-14 px-4 pb-20 pt-14 sm:px-6 lg:grid-cols-[1.1fr_1fr] lg:px-8 lg:pb-28 lg:pt-20">
            <div>
                <p class="eyebrow text-amber-400">{{ 'Time card · Monday to Friday'|trans }}</p>
                <h1 class="mt-5 font-display text-5xl font-extrabold leading-[0.98] tracking-tight text-white sm:text-6xl lg:text-7xl">
                    {{ 'Know when you can leave.'|trans }}
                </h1>
                <p class="mt-7 max-w-xl text-lg leading-8 text-ink-300">
                    {{ 'Type your four times of the day. Clocking balances each day against your weekly hours, adds the week up and shows the exact time you can go home.'|trans }}
                </p>
                <div class="mt-9 flex flex-wrap items-center gap-3">
                    <a href="{{ path('app_register') }}" class="btn btn-amber btn-lg">
                        {{ 'Create account'|trans }}
                        {{ icons.icon('arrow-right', 'h-5 w-5') }}
                    </a>
                    <a href="{{ path('app_login') }}" class="btn btn-on-ink btn-lg">
                        {{ icons.icon('login', 'h-5 w-5') }}
                        {{ 'Sign in'|trans }}
                    </a>
                </div>
                <p class="mt-5 text-sm text-ink-400">{{ 'Self-hosted, no tracking. The first account becomes the administrator.'|trans }}</p>
            </div>

            {# The product's own "today" display, at hero scale #}
            <div class="relative mx-auto w-full max-w-md">
                <div class="rounded-2xl bg-ink-800 p-6 ring-1 ring-white/10 shadow-[0_30px_60px_-30px_rgb(0_0_0/0.8)] sm:p-8">
                    <div class="flex items-center justify-between">
                        <p class="eyebrow text-ink-400">{{ 'Friday'|trans }} · 08:04 → 12:10 → 12:55</p>
                        <span class="badge badge-live">{{ 'live'|trans }}</span>
                    </div>
                    <p class="mt-6 text-sm text-ink-300">{{ 'You can leave at'|trans }}</p>
                    <div class="mt-2">{{ flap.display('16:31', '', 'clamp(2.75rem, 8vw, 4.25rem)') }}</div>
                    <div class="mt-6 border-t border-dashed border-white/15 pt-5">
                        <p class="text-sm text-ink-300">{{ 'With the week balance'|trans }} <span class="badge badge-positive ml-1">+0:28</span></p>
                        <div class="mt-2">{{ flap.display('16:03', 'flap-amber', 'clamp(1.75rem, 5vw, 2.5rem)') }}</div>
                    </div>
                </div>
                <p class="mt-3 text-center font-mono text-[11px] uppercase tracking-[0.18em] text-ink-500">{{ 'Sample week · 38h30 · 1h lunch · 45 min on Friday'|trans }}</p>
            </div>
        </div>
    </section>

    {# ------------------------------------------------ The day, in order #}
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <div class="max-w-2xl">
            <p class="eyebrow text-cobalt-600">{{ 'How it works'|trans }}</p>
            <h2 class="mt-3 text-3xl font-bold text-ink-900 sm:text-4xl">{{ 'Four punches a day. Nothing else to remember.'|trans }}</h2>
            <p class="mt-3 text-ink-600">{{ 'Type the times when you have them. Every number on the page updates as you type; save when the day is done.'|trans }}</p>
        </div>
        <ol class="timecard mt-10 grid gap-px overflow-hidden rounded-xl bg-ink-200 ring-1 ring-ink-200 md:grid-cols-4">
            {% set steps = [
                {time: '08:02', icon: 'sun', title: 'Morning in', text: 'Your leaving-time estimate appears the moment you clock in.'},
                {time: '12:15', icon: 'coffee', title: 'Lunch out', text: 'The break is checked against the minimum you set. Shorter breaks are not credited.'},
                {time: '13:10', icon: 'coffee', title: 'Back from lunch', text: 'Took longer? The estimate moves back by exactly the extra minutes.'},
                {time: '17:05', icon: 'moon', title: 'Evening out', text: 'The day is balanced to the minute and added to the week.'},
            ] %}
            {% for step in steps %}
                <li class="bg-white p-6">
                    <div class="flex items-center justify-between">
                        <span class="font-mono text-2xl font-medium tabular-nums text-ink-900">{{ step.time }}</span>
                        <span class="flex h-9 w-9 items-center justify-center rounded-md bg-cobalt-50 text-cobalt-600">{{ icons.icon(step.icon, 'h-5 w-5') }}</span>
                    </div>
                    <h3 class="mt-4 text-base font-semibold text-ink-900">{{ step.title|trans }}</h3>
                    <p class="mt-1.5 text-sm leading-6 text-ink-600">{{ step.text|trans }}</p>
                </li>
            {% endfor %}
        </ol>
    </section>

    {# ------------------------------------------------ Rules and multi-user #}
    <section class="border-y border-ink-200 bg-white">
        <div class="mx-auto grid max-w-7xl gap-10 px-4 py-16 sm:px-6 lg:grid-cols-3 lg:px-8">
            {% set features = [
                {icon: 'scale', title: 'A fair lunch-break rule', text: 'A break shorter than the minimum is not credited, so the clock cannot be gamed. Choose the days where a shorter break is fine.'},
                {icon: 'chart', title: 'The week adds up', text: 'Daily balances cumulate from Monday to Friday and shift the time you can leave today: ahead, leave earlier; behind, stay a bit.'},
                {icon: 'calendar-x', title: 'Days off in one click', text: 'A day off leaves the week entirely: no balance, no estimate, no noise. Click again to bring it back.'},
            ] %}
            {% for feature in features %}
                <div>
                    <span class="flex h-10 w-10 items-center justify-center rounded-md bg-ink-900 text-amber-400">{{ icons.icon(feature.icon, 'h-5 w-5') }}</span>
                    <h3 class="mt-4 text-lg font-semibold text-ink-900">{{ feature.title|trans }}</h3>
                    <p class="mt-2 text-sm leading-6 text-ink-600">{{ feature.text|trans }}</p>
                </div>
            {% endfor %}
        </div>
    </section>

    {# ------------------------------------------------ Call to action #}
    <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
        <div class="flex flex-col items-start justify-between gap-6 rounded-2xl bg-ink-900 p-8 text-white sm:flex-row sm:items-center sm:p-12">
            <div>
                <h2 class="text-3xl font-bold">{{ 'Ready to leave on time?'|trans }}</h2>
                <p class="mt-2 text-ink-300">{{ 'Create your account, set your weekly hours and lunch break, and clock in tomorrow morning.'|trans }}</p>
            </div>
            <div class="flex flex-wrap gap-3">
                <a href="{{ path('app_register') }}" class="btn btn-amber btn-lg">
                    {{ 'Create account'|trans }}
                    {{ icons.icon('arrow-right', 'h-5 w-5') }}
                </a>
                <a href="{{ path('app_login') }}" class="btn btn-on-ink btn-lg">{{ 'I already have one'|trans }}</a>
            </div>
        </div>
    </section>
{% endblock %}
