{% import '_partials/icons.html.twig' as icons %}
{% set route = app.request.attributes.get('_route') %}
{% set nav_links = [
    {route: 'app_home', match: ['app_home', 'app_week'], label: 'My week', icon: 'calendar'},
    {route: 'app_schedule', match: ['app_schedule'], label: 'Working hours', icon: 'cog'},
] %}
{% if is_granted('ROLE_ADMIN') %}
    {% set nav_links = nav_links|merge([{route: 'admin_users', match: ['admin_dashboard', 'admin_users', 'admin_user_new'], label: 'Accounts', icon: 'users'}]) %}
{% endif %}

<header class="band sticky top-0 z-30 border-b border-white/10" data-controller="toggle">
    <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-4 sm:px-6 lg:px-8" aria-label="{{ 'Main navigation'|trans }}">
        <a href="{{ path(app.user ? 'app_home' : 'app_landing') }}" class="flex items-center gap-2.5 text-white">
            <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-ink-800 text-amber-400 ring-1 ring-white/10">
                {{ icons.icon('clock', 'h-5 w-5') }}
            </span>
            <span class="font-display text-lg font-bold tracking-tight">Clocking</span>
        </a>

        {% if app.user %}
            <div class="hidden items-center gap-1 md:flex">
                {% for link in nav_links %}
                    <a href="{{ path(link.route) }}" class="nav-link{% if route in link.match %} nav-link-active{% endif %}">
                        {{ icons.icon(link.icon, 'h-4 w-4') }}
                        {{ link.label|trans }}
                    </a>
                {% endfor %}
            </div>

            <div class="hidden items-center gap-3 md:flex">
                {% include '_partials/lang_switch.html.twig' with {tone: 'ink'} only %}
                <a href="{{ path('app_profile') }}" class="nav-link{% if route == 'app_profile' %} nav-link-active{% endif %}" title="{{ app.user.email }}">
                    <span class="flex h-7 w-7 items-center justify-center rounded-full bg-amber-400 font-mono text-xs font-semibold uppercase text-ink-950">
                        {{ app.user.displayName|first }}
                    </span>
                    {{ app.user.displayName }}
                </a>
                <a href="{{ path('app_logout') }}" class="btn btn-ghost btn-sm text-ink-300 hover:bg-white/8 hover:text-white" title="{{ 'Sign out'|trans }}">
                    {{ icons.icon('logout', 'h-4 w-4') }}
                    <span class="sr-only">{{ 'Sign out'|trans }}</span>
                </a>
            </div>

            <button type="button" class="btn btn-icon btn-on-ink md:hidden" data-action="toggle#toggle" aria-label="{{ 'Open menu'|trans }}">
                {{ icons.icon('menu', 'h-5 w-5') }}
            </button>
        {% else %}
            <div class="flex items-center gap-3">
                {% include '_partials/lang_switch.html.twig' with {tone: 'ink'} only %}
                <a href="{{ path('app_login') }}" class="btn btn-on-ink hidden sm:inline-flex">{{ 'Sign in'|trans }}</a>
                <a href="{{ path('app_register') }}" class="btn btn-amber px-3 py-1.5 text-xs sm:px-4 sm:py-2 sm:text-sm">
                    {{ 'Create account'|trans }}
                    {{ icons.icon('arrow-right', 'h-4 w-4') }}
                </a>
            </div>
        {% endif %}
    </nav>

    {% if app.user %}
        <div class="border-t border-white/10 px-4 py-3 md:hidden" data-toggle-target="panel" hidden>
            <div class="flex flex-col gap-1">
                {% for link in nav_links %}
                    <a href="{{ path(link.route) }}" class="nav-link{% if route in link.match %} nav-link-active{% endif %}">
                        {{ icons.icon(link.icon, 'h-4 w-4') }}
                        {{ link.label|trans }}
                    </a>
                {% endfor %}
                <a href="{{ path('app_profile') }}" class="nav-link{% if route == 'app_profile' %} nav-link-active{% endif %}">
                    {{ icons.icon('user', 'h-4 w-4') }}
                    {{ app.user.displayName }}
                </a>
                <a href="{{ path('app_logout') }}" class="nav-link">
                    {{ icons.icon('logout', 'h-4 w-4') }}
                    {{ 'Sign out'|trans }}
                </a>
                <div class="px-3 pt-2">
                    {% include '_partials/lang_switch.html.twig' with {tone: 'ink'} only %}
                </div>
            </div>
        </div>
    {% endif %}
</header>
