{% extends 'base.html.twig' %}
{% import '_partials/icons.html.twig' as icons %}
{% import '_partials/flap.html.twig' as flap %}

{#
    Two-column layout shared by the sign-in and sign-up pages.
    Children fill: title, auth_heading, auth_subheading, auth_form, auth_footer.
#}
{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{% block main %}
    <div class="grid min-h-screen lg:grid-cols-[minmax(0,5fr)_minmax(0,6fr)]">
        <aside class="band relative hidden overflow-hidden lg:flex lg:flex-col lg:justify-between lg:p-12">
            <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(40rem_28rem_at_10%_100%,rgb(43_76_242_/_0.35),transparent_70%)]"></div>
            <a href="{{ path('app_landing') }}" class="relative flex items-center gap-2.5 text-white">
                <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-ink-800 text-amber-400 ring-1 ring-white/10">{{ icons.icon('clock', 'h-5 w-5') }}</span>
                <span class="font-display text-lg font-bold tracking-tight">Clocking</span>
            </a>
            <div class="relative max-w-md">
                <p class="text-sm text-ink-300">{{ 'You can leave at'|trans }}</p>
                <div class="mt-2">{{ flap.display('16:31', '', '3.5rem') }}</div>
                <h2 class="mt-10 text-3xl font-bold leading-tight text-white">{{ 'Every minute counted, to the minute.'|trans }}</h2>
                <ul class="mt-6 space-y-3 text-ink-300">
                    <li class="flex gap-3">{{ icons.icon('check', 'h-5 w-5 shrink-0 text-amber-400') }} {{ 'Daily balance against your weekly hours'|trans }}</li>
                    <li class="flex gap-3">{{ icons.icon('check', 'h-5 w-5 shrink-0 text-amber-400') }} {{ 'The week cumulated from Monday to Friday'|trans }}</li>
                    <li class="flex gap-3">{{ icons.icon('check', 'h-5 w-5 shrink-0 text-amber-400') }} {{ 'A live estimate of the time you can leave'|trans }}</li>
                </ul>
            </div>
            <p class="relative eyebrow text-ink-500">{{ 'Time card · Monday to Friday'|trans }}</p>
        </aside>

        <div class="flex flex-col px-4 py-8 sm:px-8 lg:px-16 lg:py-12">
            <div class="flex items-center justify-between">
                <a href="{{ path('app_landing') }}" class="flex items-center gap-2.5 text-ink-900 lg:invisible">
                    <span class="flex h-9 w-9 items-center justify-center rounded-lg bg-ink-900 text-amber-400">{{ icons.icon('clock', 'h-5 w-5') }}</span>
                    <span class="font-display text-lg font-bold tracking-tight">Clocking</span>
                </a>
                {% include '_partials/lang_switch.html.twig' with {tone: 'paper'} only %}
            </div>
            <div class="m-auto w-full max-w-md py-10">
                <h1 class="text-3xl font-bold text-ink-900 sm:text-4xl">{% block auth_heading %}{% endblock %}</h1>
                <p class="mt-2 text-sm text-ink-600">{% block auth_subheading %}{% endblock %}</p>
                <div class="mt-8">
                    {% include '_partials/flashes.html.twig' %}
                    {% block auth_form %}{% endblock %}
                </div>
                <p class="mt-8 text-center text-sm text-ink-600">{% block auth_footer %}{% endblock %}</p>
            </div>
        </div>
    </div>
{% endblock %}
