<!DOCTYPE html>
<html lang="{{ app.request.locale }}" class="h-full">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Clocking{% endblock %}</title>
        <meta name="description" content="{{ 'Clock in, clock out, know when you can leave.'|trans }}">
        <link rel="icon" href="data:image/svg+xml,{{ '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><rect width="24" height="24" rx="5" fill="%2314172b"/><circle cx="12" cy="12" r="7" fill="none" stroke="%23ffb020" stroke-width="2"/><path d="M12 8v4l2.5 1.5" fill="none" stroke="%23ffb020" stroke-width="2" stroke-linecap="round"/></svg>'|url_encode }}">
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}
        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </head>
    <body class="bg-paper text-ink-800">
        {% block header %}
            {% include '_partials/navbar.html.twig' %}
        {% endblock %}

        <main class="flex-1">
            {% block main %}
                {# Page title lives on the ink band; the content sheet slides out of it. #}
                <div class="band">
                    <div class="mx-auto w-full max-w-7xl px-4 pb-12 pt-8 sm:px-6 lg:px-8">
                        {% block band %}{% endblock %}
                    </div>
                </div>
                <div class="mx-auto w-full max-w-7xl px-4 pb-12 sm:px-6 lg:px-8 -mt-6">
                    {% include '_partials/flashes.html.twig' %}
                    {% block body %}{% endblock %}
                </div>
            {% endblock %}
        </main>

        {% block footer %}
            <footer class="border-t border-ink-200 py-6 text-center font-mono text-[11px] uppercase tracking-[0.18em] text-ink-400">
                Clocking &middot; {{ 'Clock in, clock out, know when you can leave.'|trans }}
            </footer>
        {% endblock %}
    </body>
</html>
