<!DOCTYPE html>
<html lang="en" class="h-full">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Clocking{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,{{ '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="%230f766e" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>'|url_encode }}">
        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}
        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </head>
    <body class="bg-stone-50 text-stone-800">
        {% block header %}
            {% include '_partials/navbar.html.twig' %}
        {% endblock %}

        <main class="flex-1">
            {% block main %}
                <div class="mx-auto w-full max-w-7xl px-4 py-8 sm:px-6 lg:px-8">
                    {% include '_partials/flashes.html.twig' %}
                    {% block body %}{% endblock %}
                </div>
            {% endblock %}
        </main>

        {% block footer %}
            <footer class="border-t border-stone-200 py-6 text-center text-xs text-stone-500">
                Clocking &middot; clock in, clock out, know when you can leave.
            </footer>
        {% endblock %}
    </body>
</html>
